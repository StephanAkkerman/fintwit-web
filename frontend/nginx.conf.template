# Rendered by the nginx image's envsubst step at container start; only
# ${API_KEY} is substituted (see NGINX_ENVSUBST_FILTER in the Dockerfile), so
# nginx's own $variables are left alone.
server {
    listen 80;
    server_name _;

    # Re-resolve Docker service names so backend container restarts do not
    # leave nginx pinned to a stale upstream IP.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $backend_upstream http://backend:7999;

    root /usr/share/nginx/html;
    index index.html;

    location = /api/stream {
        proxy_pass $backend_upstream/api/stream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        # Empty when API_KEY is unset, and nginx then omits the header.
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600;
    }

    location /api/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
