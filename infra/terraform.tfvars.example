# Get it from https://dash.cloudflare.com/profile/api-tokens
cloudflare_api_token = "paste-your-cloudflare-api-token"
cloudflare_account_id = "paste-your-account-id"
# Replace with your own domain, delegated to Cloudflare nameservers.
zone_name             = "example.com"
subdomain             = "fintwit"
tunnel_name           = "fintwit-pi"
# If cloudflared runs outside docker compose on the Pi host, use http://localhost:3000
# If cloudflared runs inside docker compose (profile tunnel), keep http://frontend:80
tunnel_origin_url = "http://frontend:80"

# Only these addresses can log in (Cloudflare Access hosted one-time-PIN screen).
# Add anyone else you want to give access to, e.g. ["you@example.com", "friend@example.com"]
access_allowed_emails = ["you@example.com"]
