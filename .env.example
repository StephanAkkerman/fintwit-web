# Copy this file to `.env` at the repo root and fill in what you need.
# Everything is optional: with nothing set, the dashboard runs without the tweet
# timeline. The X section is the only one most people need.
# Keep `KEY=value` formatting (no spaces around `=`) for Docker Compose compatibility.
# Every variable, including tuning knobs not listed here: docs/configuration.md

# --- X/Twitter timeline ---
# Two cookies from your logged-in x.com session: open DevTools (F12) ->
# Application (Firefox: Storage) -> Cookies -> https://x.com, and copy the values
# of `auth_token` and `ct0`. They grant full access to your X account, so treat
# them like a password. Recapture both if the dashboard reports the session expired.
X_AUTH_TOKEN=
X_CT0=

# --- API key (optional) ---
# Requires an X-API-Key header on the backend's /api. The dashboard keeps working:
# nginx (Docker) and the Vite dev proxy attach the key server-side.
API_KEY=

# --- Docker Compose ---
# Extra services to start alongside backend + frontend, comma-separated:
# "ibkr" (Interactive Brokers gateway) and/or "tunnel" (Cloudflare Tunnel).
COMPOSE_PROFILES=

# --- Optional integrations: uncomment the block for each one you want ---

# Reddit API: more reliable r/wallstreetbets access than the unauthenticated
# fallback. Create a "script" app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Signa signal API
# SIGNA_KEY=

# Interactive Brokers portfolio sync. With Docker, also add "ibkr" to
# COMPOSE_PROFILES. TRADING_MODE is live or paper.
# IBKR_ENABLED=true
# TRADING_MODE=live
# TWS_USERID=
# TWS_PASSWORD=
# VNC_SERVER_PASSWORD=change-me-to-a-strong-password

# Public hosting via Cloudflare Tunnel. Also add "tunnel" to COMPOSE_PROFILES.
# The token comes from `terraform output -raw tunnel_token` in infra/.
# CLOUDFLARE_TUNNEL_TOKEN=

# Admin page "invite" panel (Cloudflare Access allowlist); see
# infra/README.md#admin-page-invites for how to create the scoped token.
# CLOUDFLARE_ACCESS_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_APP_ID=
# CLOUDFLARE_ACCESS_POLICY_ID=
