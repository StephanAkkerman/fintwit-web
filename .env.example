# Copy this file to `.env` at the repo root and fill in the values you need.
# Keep `KEY=value` formatting (no spaces around `=`) for Docker Compose compatibility.
# Everything is optional: without any values the dashboard runs, just without the
# tweet timeline. The X section below is the only one most people need.

# --- X/Twitter timeline ---
# Two cookies from your logged-in x.com session: open DevTools (F12) ->
# Application (Firefox: Storage) -> Cookies -> https://x.com, and copy the values
# of `auth_token` and `ct0`. They grant full access to your X account — treat
# them like a password. Recapture them if the dashboard reports the session expired.
X_AUTH_TOKEN=
X_CT0=
# Only needed if X rotates the Following timeline's GraphQL query id before an
# xtimeline update ships: copy it from the HomeLatestTimeline request URL.
X_TIMELINE_QUERY_ID=

# --- Docker Compose profiles ---
# By default (no profiles), `docker compose up -d --build` runs only the
# backend + frontend, bound to 127.0.0.1 — nothing leaves your machine/LAN.
# Add profiles here to opt into extra services instead of passing --profile
# on every command: "ibkr" starts the ibgateway container (also set
# IBKR_ENABLED=true below), "tunnel" starts cloudflared for public hosting
# (also set CLOUDFLARE_TUNNEL_TOKEN below). Combine with a comma, e.g.
# COMPOSE_PROFILES=ibkr,tunnel
COMPOSE_PROFILES=

# --- Core ---
# SQLite by default; point at a Postgres DSN to use Postgres instead.
DB_URL=sqlite+aiosqlite:///./data.db
# Protects the backend's API with an X-API-Key header. The dashboard keeps working:
# the Docker nginx and the Vite dev proxy attach the key to /api calls server-side.
# Leave blank to disable auth locally.
API_KEY=

# --- ML / chart recognition ---
# Disable if a Raspberry Pi (or other ARM/older CPU) crashes with a PyTorch
# "Illegal instruction" error during chart classification or extraction.
CHART_ENABLED=true
CHART_EXTRACTION_ENABLED=true
# Pin/downgrade the PyTorch build used by the backend Docker image.
TORCH_VERSION=2.8.0

# --- Interactive Brokers (portfolio sync; optional) ---
IBKR_ENABLED=false
IBKR_HOST=ibgateway
# live=4003, paper=4004 when using ghcr.io/gnzsnz/ib-gateway (socat ports).
IBKR_PORT=4003
IBKR_CLIENT_ID=1
IBKR_CONNECT_TIMEOUT=30
IBKR_SYNC_INTERVAL=60
PORTFOLIO_SNAPSHOT_INTERVAL=1800
# live or paper; keep in sync with IBKR_PORT above.
TRADING_MODE=live
TWS_USERID=
TWS_PASSWORD=
# Change this — it protects VNC access to the IB Gateway container.
VNC_SERVER_PASSWORD=change-me-to-a-strong-password

# --- Trader call scoring ---
TRADER_EVAL_INTERVAL=3600

# --- Signa (optional signal API integration) ---
SIGNA_KEY=

# --- Reddit (optional; used by the WallStreetBets service for more reliable access) ---
# Modern names
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fintwit-web
# Legacy fintwit-bot compatible names (either set works)
REDDIT_PERSONAL_USE=
REDDIT_SECRET=
REDDIT_APP_NAME=fintwit-web
# Optional, only if your Reddit app config requires user auth
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- Cloudflare Tunnel (public hosting; optional) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Cloudflare Access allowlist (optional; powers the Admin page's "invite" panel) ---
# A token scoped to Account: Access: Apps and Policies Edit only — create a separate
# one from the Terraform token at https://dash.cloudflare.com/profile/api-tokens so a
# leaked runtime token can't touch DNS or the tunnel.
CLOUDFLARE_ACCESS_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# From `terraform output access_application_id` / `terraform output access_policy_id`
# in infra/ after applying the Cloudflare Access setup.
CLOUDFLARE_ACCESS_APP_ID=
CLOUDFLARE_ACCESS_POLICY_ID=
